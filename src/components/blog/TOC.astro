---
import type { MarkdownHeading } from "astro";
import { generateToc } from "@/utils/generateToc";
import TOCHeading from "./TOCHeading.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const toc = generateToc(headings);
---

<aside
	class="hidden lg:sticky lg:top-12 lg:order-2 lg:block lg:w-[192px] lg:shrink-0"
>
	<nav class="border-l border-zinc-200 pl-5 dark:border-zinc-700">
		<h2 class="mb-4 text-sm font-semibold text-zinc-700 dark:text-zinc-200">
			Contents
		</h2>

		<ol class="space-y-1">
			{toc.map((heading) => <TOCHeading heading={heading} />)}
		</ol>
	</nav>
</aside>

<script>
	const ACTIVE_OFFSET = 140;

	const links = Array.from(
		document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
	);

	const items = links
		.map((link) => {
			const id = link.dataset.headingId;

			if (!id) return null;

			const heading = document.getElementById(id);

			if (!heading) return null;

			return {
				id,
				link,
				heading,
			};
		})
		.filter(
			(
				item,
			): item is {
				id: string;
				link: HTMLAnchorElement;
				heading: HTMLElement;
			} => item !== null,
		);

	let lockedId: string | null = null;
	let scrollEndTimer: number | undefined;

	function setActive(id: string) {
		for (const item of items) {
			item.link.dataset.active = (item.id === id).toString();
		}
	}

	function updateActiveHeading() {
		if (items.length === 0) return;

		// TOC를 클릭해서 smooth scroll 중일 때는
		// 클릭한 항목의 highlight를 유지한다.
		if (lockedId) {
			setActive(lockedId);
			return;
		}

		let currentId = items[0].id;

		for (const item of items) {
			const top = item.heading.getBoundingClientRect().top;

			if (top <= ACTIVE_OFFSET) {
				currentId = item.id;
			} else {
				break;
			}
		}

		const reachedBottom =
			window.innerHeight + window.scrollY >=
			document.documentElement.scrollHeight - 2;

		if (reachedBottom) {
			currentId = items[items.length - 1].id;
		}

		setActive(currentId);
	}

	function unlockAfterScroll() {
		window.clearTimeout(scrollEndTimer);

		scrollEndTimer = window.setTimeout(() => {
			lockedId = null;
			updateActiveHeading();
		}, 120);
	}

	let ticking = false;

	function onScroll() {
		unlockAfterScroll();

		if (ticking) return;

		ticking = true;

		requestAnimationFrame(() => {
			updateActiveHeading();
			ticking = false;
		});
	}

	for (const item of items) {
		item.link.addEventListener("click", () => {
			// 클릭 순간 해당 목차를 바로 active 처리
			lockedId = item.id;
			setActive(item.id);
		});
	}

	window.addEventListener("scroll", onScroll, { passive: true });

	window.addEventListener("hashchange", () => {
		const id = decodeURIComponent(
			window.location.hash.replace(/^#/, ""),
		);

		if (id) {
			lockedId = id;
			setActive(id);
		}
	});

	updateActiveHeading();
</script>